sample_311 |>
filter(
complaint_type == "UNSANITARY CONDITION" &
descriptor == "PESTS"
)
pest_data = sample_311 |>
filter(
complaint_type == "UNSANITARY CONDITION" &
descriptor == "PESTS"
)
leaflet(data = pest_data) %>%
addTiles() %>%
addMarkers(
lng = ~longitude,
lat = ~lattitude,
)
leaflet(data = pest_data) %>%
addTiles() %>%
addMarkers(
lng = ~longitude,
lat = ~latitude,
)
leaflet(data = pest_data) %>%
addTiles() %>%
addMarkers(
lng = ~longitude,
lat = ~latitude,
)
leaflet(data = pest_data) %>%
addTiles() %>%
addCircleMarkers(
lng = ~longitude,
lat = ~latitude,
color = borough
)
leaflet(data = pest_data) %>%
addTiles() %>%
addCircleMarkers(
lng = ~longitude,
lat = ~latitude,
color = park_borough
)
leaflet(data = pest_data) %>%
addTiles() %>%
addCircleMarkers(
lng = ~longitude,
lat = ~latitude,
color = ~pal(park_borough)
)
leaflet(data = pest_data) %>%
addTiles() %>%
addCircleMarkers(
lng = ~longitude,
lat = ~latitude,
color = ~park_borough
)
